# Copy to cloud.env and fill in. cloud.env is gitignored and must stay that way.
# Run `make cloud-check` after editing.

CLOUD_PROVIDER=aws                      # aws | azure | gcp   (local is for development only)
PROJECT_ID=itcs355-<studentid>
REGION=<your nearest region>

# --- capability slots -------------------------------------------------------
# AWS    BLOB_URI=s3://<bucket>/itcs355
#        CONTAINER_REGISTRY=<account>.dkr.ecr.<region>.amazonaws.com/itcs355
# Azure  BLOB_URI=https://<account>.blob.core.windows.net/<container>/itcs355
#        CONTAINER_REGISTRY=<registry>.azurecr.io/itcs355
# GCP    BLOB_URI=gs://<bucket>/itcs355
#        CONTAINER_REGISTRY=<region>-docker.pkg.dev/<project>/itcs355
BLOB_URI=
CONTAINER_REGISTRY=

# Self-hosted MLflow is the portable choice. File-based stores are rejected by
# MLflow 3.x, so use sqlite locally and a database backend on a server.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

MODEL_REGISTRY_NAME=itcs355-<studentid>
IDENTITY_REF=                           # IAM role ARN | managed identity | service account

BUDGET_LIMIT_THB=800

# --- Lab 5 Task 4: the second provider -------------------------------------
# Read only by `make swap-check SECOND=azure` and infra/azure/lab5-swap.sh. Prefixed so
# the primary's slots above stay untouched; a slot left unset here is inherited from the
# primary, and swap-check refuses to run rather than point Azure code at GCP resources.
# Storage account and registry names are global: 3-24 lowercase letters and digits.
# PROJECT_ID is the resource group; IDENTITY_REF the user-assigned managed identity.
# No comments after a value on these lines: src/config.py would read them as the value.
AZURE_PROJECT_ID=itcs355-<studentid>
AZURE_REGION=southeastasia
AZURE_BLOB_URI=https://itcs355<studentid>.blob.core.windows.net/itcs355/itcs355
AZURE_CONTAINER_REGISTRY=itcs355<studentid>.azurecr.io/itcs355
AZURE_IDENTITY_REF=itcs355-serve-id
# Emulator only (infra/azure/emulator-demo.sh sets these itself; never set them here):
#   AZURE_STORAGE_KEY    Azurite's public account key
#   AZURE_ENDPOINT_URL   a local container standing in for the Container Apps app
